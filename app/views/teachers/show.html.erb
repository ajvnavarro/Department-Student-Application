<p style="color: green"><%= notice %></p>
  
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
  <div>
    <h1 class="mb-1"><%= @teacher.name %></h1>
    <p class="text-muted mb-0">
      <%= @teacher.email %> 
    </p>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Edit", edit_teacher_path(@teacher), class: "btn btn-secondary" %>
    <%= link_to "Back to Teachers", teachers_path, class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", @teacher, method: :delete, class: "btn btn-danger" %>
  </div>
</div>

  <div class="row g-3 mb-4">
    <div class="col-sm-6 mb-3 mb-sm-0">
      <div class="card h-100">
        <div class="card-header">Teacher Information</div>
          <div class="card-body">
            <%= render @teacher %>
          </div>
        </div>
      </div> 
    <div class="col-sm-6">
      <div class="card h-100">
        <div class="card-header">Salary Summary</div>
          <div class="card-body text-center" >
            <div class="fs-3 fw-bold"><%= number_to_currency @teacher.monthly_salary, unit: "P" %></div>
            <div class="small text-muted">Monthly Salary</div>
          </div>
        </div>
      </div>
    </div>

  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">List of Subjects</div>
    
    <div class="card-body">
      <% if @teacher.subjects.any? %>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>Number of Units</th>
              <th>Per Unit Rate</th>
            </tr>
          </thead>
          <tbody>
            <% @teacher.subjects.each do |subject| %>
              <tr>
                <td><%= subject.name %></td>
                <td><%= subject.number_of_units %></td>
                <td><%= subject.per_unit_rate %></td>

              </tr>
            <% end %>
          </tbody>       
        </table>
      </div>
    </div>
    <% else %>
      <div class="card-body text-muted">
        This teacher is not assigned in any subject yet.
      </div>
    <% end %>
  </div>
