<p style="color: green"><%= notice %></p>

<% if @teacher.subjects.any? %>
  <div>
  <h3>Teacher Information </h3>
  <%= render @teacher %>
  </div>

  <div>
  <h3>Salary Summary </h3>
  <%= @teacher.monthly_salary %>
  </div>

  <h3><br>List of subjects: </h3>
  <table style="width: 50%;">
    <thead>
      <tr>
        <th style="width: 33%;">Name</th>
        <th style="width: 33%;">Number of Units</th>
        <th style="width: 33%;">Per Unit Rate</th>
      </tr>
    </thead>
  <tbody>
    <% @teacher.subjects.each do |subject| %>
      <tr>
        <td style="width: 33%;"><%= subject.name %></td>
        <td style="width: 33%;"><%= subject.number_of_units %></td>
        <td style="width: 33%;"><%= subject.per_unit_rate %></td>
      </tr>
      <% end %>
  </tbody>       
  </table>
<% end %>

<div>
  <%= link_to "Edit this teacher", edit_teacher_path(@teacher) %> |
  <%= link_to "Back to teachers", teachers_path %>

  <%= button_to "Destroy this teacher", @teacher, method: :delete %>
</div>
