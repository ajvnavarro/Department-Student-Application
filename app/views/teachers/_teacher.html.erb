<dl class="row mb-0" id="<%= dom_id teacher %>">
  <dt class="col-5 text-muted fw-normal">Name</dt>
  <dd class="col-7 fw-semibold"><%= teacher.name %></dd>

  <dt class="col-5 text-muted fw-normal">Email</dt>
  <dd class="col-7"><%= teacher.email %></dd>

  <dt class="col-5 text-muted fw-normal">Students</dt>
  <dd class="col-7"><%= teacher.specialization %></dd>

  <dt class="col-5 text-muted fw-normal">Teachers</dt>
  <dd class="col-7 mb-0"><%= teacher.department.name %></dd>
</dl>