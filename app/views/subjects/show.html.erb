<p style="color: green"><%= notice %></p>

<%= render @subject %>
<% @subject.sections.any? %>
  <h3><br>Sections</h3>
    <% @subject.sections.each do |section| %>
      <h3><%= section.name %></h3>
      <p>Room: <%=section.room %> | Timeslot: <%=section.timeslot %> | Teacher: <%=section.subject.teacher.name %></p> 
      <table style="width: 50%;">
      <thead>
        <tr>
          <th style="width: 33%;">Name</th>
          <th style="width: 33%;">Year Level</th>
          <th style="width: 33%;">Program</th>
        </tr>
        </thead>
        <tbody>
          <% section.classlists.each do |classlist| %>
            <tr>
            <td style="width: 33%;"><%= classlist.student.name %></td>
            <td style="width: 33%;"><%= classlist.student.year_level %></td>
            <td style="width: 33%;"><%= classlist.student.program %></td>
            </tr>
            <% end %>
        </tbody>  
        </table>
  <% end %>      
        
<div>
  <%= link_to "Edit this subject", edit_subject_path(@subject) %> |
  <%= link_to "Back to subjects", subjects_path %>

  <%= button_to "Destroy this subject", @subject, method: :delete %>
</div>
