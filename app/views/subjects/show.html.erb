<p style="color: green"><%= notice %></p>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
  <div>
    <h1 class="mb-1"><%= @subject.name %></h1>
    <p class="text-muted mb-0">
      <%= @subject.teacher.name %> 
    </p>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Edit", edit_subject_path(@subject), class: "btn btn-secondary" %>
    <%= link_to "Back to Subjects", subjects_path, class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", @subject, method: :delete, class: "btn btn-danger" %>
  </div>
</div>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">List of Sections</div>
  </div> 

  <div class="card mb-0">  
  <% @subject.sections.each do |section| %>
    <div class="card-header"><%= section.name %></div>
  </div>
    <div class="card">
      <div class="card-body">
        <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead>
            <tr>
              <th class="col-4">Room</th>
              <th class="col-4">Timeslot</th>
              <th class="col-4">Teacher</th>
            </tr>
          </thead>
          <tbody>
              <tr>
                <td><%= section.room %></td>
                <td><%= section.timeslot %></td>
                <td><%= section.subject.teacher.name %></td> 
              </tr>
          </tbody>
        </table>
        </div>
      </div>
    </div>

  <div class="card mb-4"> 
    <% if section.classlists.any? %>
      <div class="card-body">
        <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead>
            <tr>
              <th class="col-4">Name</th>
              <th class="col-4">Year Level</th>
              <th class="col-4">Program</th>
            </tr>
          </thead>
          <tbody>
            <% section.classlists.each do |classlist| %>
              <tr>
                <td><%= classlist.student.name %></td>
                <td><%= classlist.student.year_level %></td>
                <td><%= classlist.student.program %></td> 
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      </div>
    <% end %>
  </div>

  <% end %>

