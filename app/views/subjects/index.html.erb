
<% content_for :title, "Subjects" %>

<% if notice.present? %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>


<h1>Subjects</h1>

<div id="subjects" class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle w-100">
    <thead class="table-dark">
      <tr>
        <th class="col-5">Name</th>
        <th class="col-5">Teacher</th>
        <th class="col-2">Actions</th>
      </tr>
    </thead>  
    <tbody>
      <% @subjects.each do |subject| %>
        <tr id="<%= dom_id subject %>">
          <td><%= subject.name %></td>
          <td><%= subject.teacher.name %></td>
          <td class="text-nowrap">
          
          <%= button_to "Show", subject, method: :get,
                        class: "btn btn-sm btn-primary", form_class: "d-inline-block" %>
          <%= button_to "Edit", edit_subject_path(subject), method: :get,
                        class: "btn btn-sm btn-secondary", form_class: "d-inline-block" %>
          <%= button_to "Delete", subject, method: :delete,
                        class: "btn btn-sm btn-danger", form_class: "d-inline-block" %>
         </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to "New Subject", new_subject_path, class: "btn btn-success" %>
