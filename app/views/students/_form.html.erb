<!--input and output like response ordisplay of words-->

<div class="card d-flex p-2 text-center position-relative border-dark mb-3">
  <div class="card-header text-bg-dark mb-3"">
    <h1><%= title %></h1>
  </div>
<%= form_with(model: student) do |form| %>
  <% if student.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(student.errors.count, "error") %> prohibited this student from being saved:</h2>

      <ul>
        <% student.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="input-group mb-3">
    <%= form.label :name, class: "input-group-text", id: "basic-addon1" %>
    <%= form.text_field :name, class:"form-control", placeholder: "Full Name" %>
  </div>

  <div class="input-group mb-3">
    <%= form.label :year_level, class: "input-group-text", id: "basic-addon1" %>
    <%= form.number_field :year_level, class:"form-control", placeholder: "Year Level" %>
  </div>

  <div class="input-group mb-3">
    <%= form.label :program, class: "input-group-text", id: "basic-addon1" %>
    <%= form.text_field :program, class:"form-control", placeholder: "Program" %>
  </div>

  <div class="input-group mb-3">
    <%= form.label :department_id, class: "input-group-text", id: "basic-addon1" %>
    <%= form.collection_select :department_id,
                                Department.order(:name),
                                :id,
                                :name,
                                { prompt: "Select a department"}, class: "btn btn-outline-secondary dropdown-toggle", type:"button", type: "text", class: "form-control"%>
  </div>

  <div class="d-grid gap-2 mx-auto p-2">
    <%= form.submit class: "btn btn-success" %>
</div>  
<% end %>
