<!-- view of each student -->

<p style="color: green"><%= notice %></p>

<%= render @student %>
<% if @student.classlists.any? %>
  <h3><br>List of Sections: </h3>
  <table style="width: 50%;">
    <thead>
      <tr>
        <th style="width: 33%;">Name</th>
        <th style="width: 33%;">Room</th>
        <th style="width: 33%;">Timeslot</th>
      </tr>
    </thead>
  <tbody>
    <% @student.classlists.map(&:section).uniq.each do |section| %>
      <tr>
        <td style="width: 33%;"><%= section.name %></td>
        <td style="width: 33%;"><%= section.room %></td>
        <td style="width: 33%;"><%= section.timeslot %></td>
      </tr>
      <% end %>
  </tbody>       
  </table>
<% end %>

<div>
  <%= link_to "Edit this student", edit_student_path(@student) %> |
  <%= link_to "Back to students", students_path %>

  <%= button_to "Destroy this student", @student, method: :delete %>
</div>
