<!-- view of each student -->

<p style="color: green"><%= notice %></p>

<%= render @student %>
<% if @student.classlists.any? %>
  <h3><br>List of Sections: </h3>
  <table style="width: 70%;">
    <thead>
      <tr>
        <th style="width: 25%;">Name</th>
        <th style="width: 15%;">Section</th>
        <th style="width: 15%;">Room</th>
        <th style="width: 20%;">Timeslot</th>
        <th style="width: 33%;">Teacher</th>
      </tr>
    </thead>
  <tbody>
    <% @student.classlists.each do |classlist| %>
      <tr>
        <td style="width: 25%;"><%= classlist.section.subject.name %></td>
        <td style="width: 15;"><%= classlist.section.name %></td>
        <td style="width: 15%;"><%= classlist.section.room %></td>
        <td style="width: 20%;"><%= classlist.section.timeslot %></td>
        <td style="width: 33%;"><%= classlist.section.subject.teacher.name %></td>
        </tr>
      <% end %>
  </tbody>       
  </table>
<% end %>

<div>
  <%= link_to "Edit this student", edit_student_path(@student) %> |
  <%= link_to "Back to students", students_path %>

  <%= button_to "Destroy this student", @student, method: :delete %>
</div>
