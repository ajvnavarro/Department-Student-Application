<p style="color: green"><%= notice %></p>

<%= render @section %>
<% if @section.classlists.any? %>
  <h3><br>List of Students:</h3>
    <table style="width: 70%;">
    <thead>
      <tr>
        <th style="width: 33%;">Name</th>
        <th style="width:33%;">Year Level</th>
        <th style="width: 33%;">Program</th>
      </tr>
    </thead>
    <tbody>
      <% @section.classlists.each do |classlist| %>
        <tr>
        <td style="width: 33%;"><%= classlist.student.name %></td>
        <td style="width: 33%;"><%= classlist.student.year_level %></td>
        <td style="width: 33%;"><%= classlist.student.program %></td>
        </tr>
      <% end %>
    </tbody>  
    </table>
<% end %>

<div>
  <%= link_to "Edit this section", edit_section_path(@section) %> |
  <%= link_to "Back to sections", sections_path %>

  <%= button_to "Destroy this section", @section, method: :delete %>
</div>
