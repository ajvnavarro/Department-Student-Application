<p style="color: green"><%= notice %></p>

<%= render @department %>
<% if @department.students.any? %>
  <h3> List of Students: </h3>
  <table style="width: 50%;">
    <thead>
      <tr>
        <th style="width: 33%;">Name</th>
        <th style="width: 33%;">Prorgram</th>
        <th style="width: 10%;">Year Level</th>
      </tr>
    </head>
    <tbody>
      <% @department.students.each do |student| %>  
        <tr>
          <td style="width: 33%;"><%= student.name %></td>
          <td style="width: 33%;"><%= student.program %></td>
          <td style="width: 10%;"><%= student.year_level %></td>
        </tr>
       <% end %>
    </tbody>
  </table> 
<% end %>

<% if @department.teachers.any? %>
  <h3> <br>List of Teachers: </h3>
  <table style="width: 50%;">
    <thead>
      <tr>
        <th style="width: 33%;">Name</th>
        <th style="width: 33%;">Email</th>
        <th style="width: 33%;">Specialization</th>
      </tr>
    </head>
    <tbody>
      <% @department.teachers.each do |teacher| %>  
        <tr>
          <td style="width: 33%;"><%= teacher.name %></td>
          <td style="width: 33%;"><%= teacher.email %></td>
          <td style="width: 33%;"><%= teacher.specialization %></td>
        </tr>
       <% end %>
    </tbody>
  </table> 
<% end %>

<% if @department.laboratories.any? %>
  <h3> </br>List of Laboratories: </h3>
  <table style="width: 30%;">
    <thead>
      <tr>
        <th style="width: 33%;">Name</th>
        <th style="width: 33%;">Location</th>
      </tr>
    </head>
    <tbody>
      <% @department.laboratories.each do |laboratory| %>  
        <tr>
          <td style="width: 33%;"><%= laboratory.name %></td>
          <td style="width: 33%;"><%= laboratory.location %></td>
        </tr>
       <% end %>
    </tbody>
  </table> 
<% end %>

<div>
  <%= link_to "Edit this department", edit_department_path(@department) %> |
  <%= link_to "Back to departments", departments_path %>

  <%= button_to "Destroy this department", @department, method: :delete %>
</div>
